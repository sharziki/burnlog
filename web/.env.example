# --- Database ---
# Postgres (prod + dev). Spin up local with `docker compose up -d db`.
DATABASE_URL="postgresql://burnlog:burnlog@localhost:5432/burnlog?schema=public"

# --- Auth.js ---
# Generate with: openssl rand -base64 32
AUTH_SECRET="replace-me-with-random-string"

# Set in production only. Leave blank for local dev.
# AUTH_URL="https://burnlog.sxna.dev"

# GitHub OAuth app — https://github.com/settings/developers
# Dev callback:  http://localhost:3000/api/auth/callback/github
# Prod callback: https://<your-domain>/api/auth/callback/github
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""

# --- burnlog ---
# First user to sign in with this GitHub login becomes admin.
BURNLOG_ADMIN_LOGIN="sharziki"

# Public site URL (shown in OG metadata, CLI onboarding copy).
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Optional: redis URL for distributed rate limiting. If unset, falls back to
# in-memory sliding-window limiter (fine for single-instance deploys).
# REDIS_URL=""
