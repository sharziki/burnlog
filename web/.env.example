# SQLite for local dev. Swap to postgres://... in prod.
DATABASE_URL="file:./dev.db"

# Auth.js — run `openssl rand -base64 32` to generate.
AUTH_SECRET="replace-me-with-random-string"

# GitHub OAuth app — https://github.com/settings/developers
# Callback URL: http://localhost:3000/api/auth/callback/github
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""

# If set, the first user to sign in with this GitHub login becomes admin.
BURNLOG_ADMIN_LOGIN="sharziki"
