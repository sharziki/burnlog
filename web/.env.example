# --- Database ---
# Postgres (prod + dev). Spin up local with `docker compose up -d db`.
DATABASE_URL="postgresql://burnlog:burnlog@localhost:5432/burnlog?schema=public"

# --- Auth.js ---
# Generate with: openssl rand -base64 32
AUTH_SECRET="replace-me-with-random-string"

# Set in production only. Leave blank for local dev.
# AUTH_URL="https://burnlog.sxna.dev"

# GitHub OAuth app — https://github.com/settings/developers
# Dev callback:  http://localhost:3000/api/auth/callback/github
# Prod callback: https://<your-domain>/api/auth/callback/github
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""

# --- burnlog ---
# First user to sign in with this GitHub login becomes admin.
BURNLOG_ADMIN_LOGIN="sharziki"

# Optional: protects GET /api/team-leads CSV export.
# Generate with: openssl rand -hex 32
BURNLOG_ADMIN_TOKEN=""

# Optional: estimated cost rate used by server CSV exports.
BURNLOG_DOLLARS_PER_TOKEN="0.00001"

# Optional: same estimate shown in browser UI. Keep synced with server rate.
NEXT_PUBLIC_BURNLOG_DOLLARS_PER_TOKEN="0.00001"

# Optional: signs budget webhook payloads with x-burnlog-signature.
# Generate with: openssl rand -hex 32
BURNLOG_WEBHOOK_SECRET=""

# --- Billing (Stripe) ---
# All three or none. With none set, companies are unbilled and say so in the
# UI — the app builds and runs exactly the same either way.
# Secret key from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=""
# Signing secret for POST /api/billing/webhook. From the endpoint you create in
# the Stripe dashboard, or `stripe listen --forward-to ...` in dev.
STRIPE_WEBHOOK_SECRET=""
# Recurring price for the Company tier. The price is never hardcoded.
STRIPE_PRICE_ID=""

# Public site URL (shown in OG metadata, CLI onboarding copy).
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Optional: redis URL for distributed rate limiting. If unset, falls back to
# in-memory sliding-window limiter (fine for single-instance deploys).
# REDIS_URL=""
