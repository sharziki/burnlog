datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ---------- Auth.js tables ----------

model User {
  id            String      @id @default(cuid())
  name          String?
  email         String?     @unique
  emailVerified DateTime?
  image         String?
  username      String?     @unique // github login
  bio           String?
  createdAt     DateTime    @default(now())

  accounts          Account[]
  sessions          Session[]
  apiKeys           ApiKey[]
  burnEvents        BurnEvent[]
  groupMemberships  GroupMembership[]
  groupsCreated     Group[]          @relation("GroupCreator")
  challengesCreated Challenge[]      @relation("ChallengeCreator")
  challengeEntries  ChallengeEntry[]
}

model Group {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  description String?
  inviteCode  String   @unique
  createdAt   DateTime @default(now())
  createdById String

  createdBy   User              @relation("GroupCreator", fields: [createdById], references: [id], onDelete: Cascade)
  memberships GroupMembership[]
  challenges  Challenge[]
}

model GroupMembership {
  id        String   @id @default(cuid())
  groupId   String
  userId    String
  role      String   @default("member")
  createdAt DateTime @default(now())

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
  @@index([userId])
}

model Challenge {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  summary     String?
  status      String   @default("live")
  inviteCode  String   @unique
  startsAt    DateTime
  endsAt      DateTime
  createdAt   DateTime @default(now())
  createdById String
  hostGroupId String?

  createdBy User             @relation("ChallengeCreator", fields: [createdById], references: [id], onDelete: Cascade)
  hostGroup Group?           @relation(fields: [hostGroupId], references: [id], onDelete: SetNull)
  entries   ChallengeEntry[]

  @@index([hostGroupId])
  @@index([startsAt, endsAt])
}

model ChallengeEntry {
  id          String   @id @default(cuid())
  challengeId String
  userId      String
  createdAt   DateTime @default(now())

  challenge Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([challengeId, userId])
  @@index([userId])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ---------- burnlog tables ----------

model ApiKey {
  id        String    @id @default(cuid())
  userId    String
  keyHash   String    @unique
  label     String?
  createdAt DateTime  @default(now())
  lastUsed  DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// Tokens-only burn event. Intentionally does NOT store project, cwd,
/// filenames, prompt content, sessionId, or anything else that could
/// identify what the user was working on.
model BurnEvent {
  id                  String   @id @default(cuid())
  userId              String
  /// Dedupe key from the source CLI (e.g. Anthropic requestId, Codex rollout uuid).
  /// Random opaque ids only. Must be unique per (user, source).
  requestId           String
  /// Which CLI / agent the event came from.
  source              String // "claude-code" | "codex" | "hermes" | "openclaw" | ...
  /// Model name as reported by the source. e.g. "claude-opus-4-6", "gpt-5-codex".
  model               String
  /// Inferred from model name for the provider split chart.
  provider            String // "anthropic" | "openai" | "google" | "other"
  inputTokens         Int
  outputTokens        Int
  cacheCreationTokens Int      @default(0)
  cacheReadTokens     Int      @default(0)
  totalTokens         Int
  timestamp           DateTime
  createdAt           DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, source, requestId])
  @@index([userId, timestamp])
  @@index([userId, source])
  @@index([userId, model])
}
