datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ---------- Auth.js tables ----------

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  username      String?   @unique // github login
  bio           String?
  github        String?
  twitter       String?
  website       String?
  currentStreak Int       @default(0)
  longestStreak Int       @default(0)
  lastBurnDate  String? // "YYYY-MM-DD" UTC, for fast streak calc
  createdAt     DateTime  @default(now())

  accounts          Account[]
  sessions          Session[]
  apiKeys           ApiKey[]
  burnEvents        BurnEvent[]
  ownedClubs        Club[]             @relation("clubOwner")
  clubMemberships   ClubMembership[]
  clubAnnouncements ClubAnnouncement[]
  notifications     Notification[]
  clubAuditEvents   ClubAuditEvent[]
  achievements      Achievement[]
  hostedChallenges  Challenge[]        @relation("challengeHost")
  wonChallenges     Challenge[]        @relation("challengeWinner")
  challengeEntries  ChallengeEntry[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ---------- burnlog tables ----------

model ApiKey {
  id                  String    @id @default(cuid())
  userId              String
  clubId              String?
  keyHash             String    @unique
  label               String?
  monthlyBudgetTokens Int       @default(0)
  createdAt           DateTime  @default(now())
  lastUsed            DateTime?

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  club       Club?       @relation(fields: [clubId], references: [id], onDelete: Cascade)
  burnEvents BurnEvent[]

  @@index([clubId])
}

/// Tokens-only burn event. Intentionally does NOT store project, cwd,
/// filenames, prompt content, sessionId, or anything else that could
/// identify what the user was working on.
model BurnEvent {
  id                  String   @id @default(cuid())
  userId              String
  clubId              String?
  apiKeyId            String?
  /// Dedupe key from the source CLI (e.g. Anthropic requestId, Codex rollout uuid).
  /// Random opaque ids only. Must be unique per (user, source).
  requestId           String
  /// Which CLI / agent the event came from.
  source              String // "claude-code" | "codex" | "hermes" | "openclaw" | ...
  /// Model name as reported by the source. e.g. "claude-opus-4-6", "gpt-5-codex".
  model               String
  /// Inferred from model name for the provider split chart.
  provider            String // "anthropic" | "openai" | "google" | "other"
  inputTokens         Int
  outputTokens        Int
  cacheCreationTokens Int      @default(0)
  cacheReadTokens     Int      @default(0)
  totalTokens         Int
  timestamp           DateTime
  createdAt           DateTime @default(now())

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  club   Club?   @relation(fields: [clubId], references: [id], onDelete: Cascade)
  apiKey ApiKey? @relation(fields: [apiKeyId], references: [id], onDelete: SetNull)

  @@unique([userId, source, requestId])
  @@index([userId, timestamp])
  @@index([clubId, timestamp])
  @@index([apiKeyId])
  @@index([userId, source])
  @@index([userId, model])
}

// ---------- Clubs ----------

model Club {
  id                  String   @id @default(cuid())
  name                String
  slug                String   @unique
  description         String?
  image               String?
  isPrivate           Boolean  @default(false)
  inviteCode          String?  @unique
  plan                String   @default("free")
  monthlyBudgetTokens Int      @default(0)
  blockIngestOnBudget Boolean  @default(false)
  budgetWebhookUrl    String?
  ownerId             String
  createdAt           DateTime @default(now())

  owner         User               @relation("clubOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  apiKeys       ApiKey[]
  burnEvents    BurnEvent[]
  memberships   ClubMembership[]
  announcements ClubAnnouncement[]
  auditEvents   ClubAuditEvent[]
}

model ClubAuditEvent {
  id          String   @id @default(cuid())
  clubId      String
  actorUserId String?
  actorType   String
  action      String
  meta        String?
  createdAt   DateTime @default(now())

  club      Club  @relation(fields: [clubId], references: [id], onDelete: Cascade)
  actorUser User? @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([clubId, createdAt])
}

model ClubAnnouncement {
  id        String   @id @default(cuid())
  clubId    String
  authorId  String
  content   String
  createdAt DateTime @default(now())

  club   Club @relation(fields: [clubId], references: [id], onDelete: Cascade)
  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([clubId, createdAt])
}

model ClubMembership {
  id       String   @id @default(cuid())
  clubId   String
  userId   String
  joinedAt DateTime @default(now())

  club Club @relation(fields: [clubId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([clubId, userId])
  @@index([userId])
}

// ---------- Notifications ----------

model Notification {
  id        String   @id @default(cuid())
  userId    String
  /// Type tag for rendering: "rank_up" | "overtake" | "streak" | "milestone" | "welcome"
  type      String
  /// Human-readable notification body (plain text, max ~200 chars)
  message   String
  /// Optional JSON metadata (e.g. {"rank":"Blaze","icon":"●"} or {"by":"alice"})
  meta      String?
  /// Optional link target (e.g. "/u/alice", "/h2h/alice-vs-bob")
  link      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read, createdAt])
}

// ---------- Challenges ----------

/// A time-boxed competition between users. Scoring is derived from BurnEvent
/// rows inside [startsAt, endsAt) — nothing is written per-event, so a
/// challenge costs nothing to run and can never disagree with the leaderboard.
model Challenge {
  id          String    @id @default(cuid())
  name        String
  /// "sprint" | "efficiency" | "provider" | "streak" | "cost-cap"
  type        String
  hostId      String
  /// Short, URL-safe join code. The invite link is the growth loop.
  inviteCode  String    @unique
  /// Type-specific settings as JSON, e.g. {"provider":"anthropic"},
  /// {"targetStreak":14}, {"budgetTokens":1000000}. Null for "sprint".
  config      String?
  startsAt    DateTime
  endsAt      DateTime
  /// "active" | "ended". Settled lazily on read, so no cron is required.
  status      String    @default("active")
  winnerId    String?
  settledAt   DateTime?
  /// Set when this challenge was created via the "rematch" button.
  rematchOfId String?
  createdAt   DateTime  @default(now())

  host    User             @relation("challengeHost", fields: [hostId], references: [id], onDelete: Cascade)
  winner  User?            @relation("challengeWinner", fields: [winnerId], references: [id], onDelete: SetNull)
  entries ChallengeEntry[]

  @@index([status, endsAt])
  @@index([hostId])
}

model ChallengeEntry {
  id          String   @id @default(cuid())
  challengeId String
  userId      String
  joinedAt    DateTime @default(now())
  /// Frozen standings, written once when the challenge settles.
  finalScore  Float?
  finalPlace  Int?

  challenge Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([challengeId, userId])
  @@index([userId])
}

// ---------- Achievements ----------

/// One row per unlocked achievement. `key` is a stable id from the catalog
/// in lib/achievements.ts — the display metadata lives in code, not the DB.
model Achievement {
  id         String   @id @default(cuid())
  userId     String
  key        String
  unlockedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, key])
  @@index([userId])
}

// ---------- Sales ----------

model TeamLead {
  id         String   @id @default(cuid())
  email      String   @unique
  name       String?
  company    String?
  teamSize   String?
  useCase    String?
  source     String   @default("teams_page")
  status     String   @default("new")
  adminNotes String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}
