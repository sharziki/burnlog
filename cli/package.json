{
  "name": "@sxnalabs/burnlog",
  "version": "0.8.0",
  "description": "The public leaderboard for AI coding token usage. Counts tokens from Claude Code, Codex, Cursor, Gemini CLI, aider and 14 providers \u2014 tokens only, never prompts or code.",
  "keywords": [
    "claude-code",
    "codex",
    "cursor",
    "gemini-cli",
    "aider",
    "opencode",
    "token-usage",
    "token-tracker",
    "usage-tracker",
    "cost-tracking",
    "leaderboard",
    "ai-agents",
    "llm",
    "anthropic",
    "openai",
    "burnlog",
    "sxna"
  ],
  "author": "Sharvil Saxena <sharvilsaxena@gmail.com> (https://github.com/sharziki)",
  "license": "MIT",
  "homepage": "https://burnlog.net",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sharziki/burnlog.git",
    "directory": "cli"
  },
  "bugs": {
    "url": "https://github.com/sharziki/burnlog/issues"
  },
  "bin": {
    "burnlog": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "prepublishOnly": "npm run build",
    "test": "node --import tsx --test \"src/**/*.test.ts\""
  },
  "dependencies": {
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  }
}
