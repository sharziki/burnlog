{
  "name": "@sxna/burnlog-sdk",
  "version": "0.1.0",
  "description": "Lightweight SDK for tracking AI token burn from custom agents into burnlog.",
  "keywords": [
    "burnlog",
    "tokens",
    "anthropic",
    "openai",
    "agents",
    "sxna"
  ],
  "author": "Sharvil Saxena <sharvilsaxena@gmail.com> (https://github.com/sharziki)",
  "license": "MIT",
  "homepage": "https://github.com/sharziki/burnlog/tree/master/sdk#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sharziki/burnlog.git",
    "directory": "sdk"
  },
  "bugs": {
    "url": "https://github.com/sharziki/burnlog/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "sideEffects": false,
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "node --import=tsx --test test/*.test.ts",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  }
}
